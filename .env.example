# Copy to .env for local testing. On Netlify, add the same names under
# Site configuration → Environment variables (never commit real values).

# ── Staff orders page (/admin/) ─────────────────────────────
ADMIN_PASSWORD=
# Optional: a long random string; signs staff logins (defaults to one made from ADMIN_PASSWORD)
SESSION_SECRET=

# ── Payments ────────────────────────────────────────────────
# Stripe Dashboard → Developers → API keys (use sk_test_… while testing)
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=
# true = fake payment page instead of Stripe. Local testing only; ignored when STRIPE_SECRET_KEY is set.
DEMO_PAYMENTS=false

# ── Where orders are stored ─────────────────────────────────
# Supabase → Project Settings → API. Leave empty to use data/*.json (local only).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── New-order alerts (each one optional) ────────────────────
# Telegram: create a bot with @BotFather, then get the chat id (see ORDERING.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email through Resend (resend.com); FROM must be on a domain verified in Resend
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=
